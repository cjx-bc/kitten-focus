<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="780">
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe android:fraction="0.00" android:value="0" />
        <keyframe android:fraction="0.18" android:value="0" />
        <keyframe android:fraction="0.35" android:value="-6.5" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.65" android:value="-4.5" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="0.84" android:value="2.5" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="1.00" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
    </propertyValuesHolder>
</objectAnimator>
