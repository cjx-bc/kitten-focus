<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="1000">
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe android:fraction="0.00" android:value="0" />
        <keyframe android:fraction="0.36" android:value="0" />
        <keyframe android:fraction="0.45" android:value="-6" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="0.57" android:value="8" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="0.72" android:value="3" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="0.90" android:value="-4" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="0.98" android:value="0" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="1.00" android:value="0" />
    </propertyValuesHolder>
</objectAnimator>
