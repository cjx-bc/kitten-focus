<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="1000">
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe android:fraction="0.00" android:value="0" />
        <keyframe android:fraction="0.34" android:value="0" />
        <keyframe android:fraction="0.41" android:value="15" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.48" android:value="-4" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.55" android:value="6" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.73" android:value="3.5" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="0.90" android:value="-2" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="0.98" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="1.00" android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">
        <keyframe android:fraction="0.00" android:value="1" />
        <keyframe android:fraction="0.34" android:value="1" />
        <keyframe android:fraction="0.41" android:value="0.94" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.48" android:value="1.03" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.55" android:value="0.98" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.73" android:value="1" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="1.00" android:value="1" />
    </propertyValuesHolder>
</objectAnimator>
