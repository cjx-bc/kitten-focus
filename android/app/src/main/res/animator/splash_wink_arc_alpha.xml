<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="780">
    <propertyValuesHolder
        android:propertyName="strokeAlpha"
        android:valueType="floatType">
        <keyframe android:fraction="0.00" android:value="0" />
        <keyframe android:fraction="0.27" android:value="0" />
        <keyframe android:fraction="0.34" android:value="1" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="0.65" android:value="1" />
        <keyframe android:fraction="0.72" android:value="0" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="1.00" android:value="0" />
    </propertyValuesHolder>
</objectAnimator>
