{
  "name": "xiaomao-focus",
  "private": true,
  "version": "0.2.17",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:dev-install": "node scripts/android-dev-install.mjs",
    "android:install": "node scripts/android-dev-install.mjs --skip-build",
    "android:grant": "node scripts/android-dev-install.mjs --grant-only"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@lucide/vue": "1.73.0",
    "echarts": "6.1.0",
    "idb": "8.0.4",
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.11",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
